# Copia questo file in `.env` e riempi i valori reali.
# I segreti non entrano mai nel repository.

NODE_ENV=development

# Database (solo api, worker e migrate)
DATABASE_URL=postgres://nando:nando@127.0.0.1:5432/nando_dev
TEST_DATABASE_URL=postgres://nando:nando@127.0.0.1:5432/nando_test

# Identità applicativa
OWNER_USER_ID=00000000-0000-7000-8000-000000000000
INTERNAL_TOKEN=change-me

# Processi
API_URL=http://127.0.0.1:3000
PORT=3001
DOCS_ENABLED=true
