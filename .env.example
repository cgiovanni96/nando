# Copia questo file in `.env` e riempi i valori reali.
# I segreti non entrano mai nel repository.

NODE_ENV=development

# Database (solo api, worker e migrate)
# Il compose dev pubblica Postgres su 5433 per non collidere con un
# eventuale PostgreSQL locale già in ascolto su 5432.
DATABASE_URL=postgres://nando:nando@127.0.0.1:5433/nando_dev
TEST_DATABASE_URL=postgres://nando:nando@127.0.0.1:5433/nando_test

# Identità applicativa
OWNER_USER_ID=0199a4c2-7a10-7000-8000-000000000001
INTERNAL_TOKEN=dev-only-0123456789abcdef0123456789abcdef

# Processi
# Le porte locali usano i default: api 3000, web 3001.
# In staging e produzione le imposta il compose.
API_URL=http://127.0.0.1:3000
DOCS_ENABLED=true
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
