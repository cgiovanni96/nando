{
  "name": "@nando/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:check": "node scripts/check-drizzle-drift.mjs",
    "start:migrate": "tsx src/scripts/migrate.ts && tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@nando/kernel": "workspace:*",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
