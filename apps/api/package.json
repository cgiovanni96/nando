{
  "name": "@nando/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./type": {
      "types": "./src/type.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "start:migrate": "node dist/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "docs:check": "tsx scripts/docs-check.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@nando/kernel": "workspace:*",
    "@nando/platform": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.18",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "hono-openapi": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.11.0"
  }
}
